# dsh 部署配置：与 docker-compose.yml 同目录，docker compose 自动读取。
# 修改后执行 docker compose up -d 重建生效。

# 模型访问（聊天必需）。
DEEPSEEK_API_KEY=

# 可选：自定义 DeepSeek 兼容端点（默认 https://api.deepseek.com）。
# DEEPSEEK_BASE_URL=https://your-proxy.example.com/v1

# 宿主机对外端口（容器内固定 9090）。
DSH_PORT=9090

# 浏览器实际访问用的 host:port（域名则不带端口），空格分隔可多个。
# 例如 "203.0.113.10:9090 dsh.example.com"。
# 本方案认证走 dsh-web-startup-auth 的登录页（首次访问注册管理员），
# 不再使用 DSH_WEB_ACCESS_KEY 密钥门禁。
DSH_TRUSTED_HOSTS=

# 自定义大模型提供方：JSON 字典，启动时合并进 settings.yaml（同名路由覆盖）。
# apiKeyEnv 名字的变量需同时在 compose environment 透传。
# 未声明 input 的模型默认按 [text, image]（支持识图）处理；设
# DSH_PROVIDERS_DEFAULT_VISION=0 恢复纯文本默认。纯文本模型（如 deepseek）
# 在条目上显式写 "input":["text"] 即可。
# DSH_LLM_PROVIDERS={"my":{"displayName":"我的模型","api":"openai-completions","baseURL":"http://172.16.23.95:3000/v1","apiKeyEnv":"MY_KEY","models":[{"id":"glm-5.2"}]}}

# 权限预设（默认 workspace-write）：仅工作区内可写，landlock 沙箱 + 审批 ask。
# 新版 dsh 自带 landlock launcher，容器共享宿主内核即可用。若日志报
# SANDBOX_UNAVAILABLE（内核过旧、无沙盒后端），改回 danger-full-access
#（免沙盒免审批，容器本身已是隔离边界）。
# DSH_PERMISSION_MODE=workspace-write

# 每日日志源目录（宿主机）：每天放入前一天的完整日志压缩包，定时任务读包分析、
# 报告 <压缩包名>.分析报告.md 写回同目录。容器内挂到工作区 daily/demosite。
# 新增日志源：compose 再加一行挂载到 /workspace/logAnalyze/daily/<源名>。
# DSH_DEMOSITE_LOG_DIR=/opt/dsh-web/demosite-log
